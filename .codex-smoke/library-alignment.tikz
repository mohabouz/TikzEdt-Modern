\usetikzlibrary{patterns, arrows.meta, calc, positioning, decorations.pathreplacing, shapes.geometric}

\begin{tikzpicture}[scale=1, line join=round, >=stealth]
    \draw[thick] (0,0) -- (6,0);
    \draw[fill=gray!40] (0.3,0) rectangle (0.4,1.9);
    \draw[fill=gray!30] (0,1.9) rectangle (0.7,2.3);
    \draw[fill=gray!50] (0.7,2) rectangle (0.9,2.2);
    \draw[fill=gray!40] (2.7,0) rectangle (2.8,1.5);
    \draw[fill=yellow!50!orange] (2.2,2.9) -- (3.3,2.7) -- (3.3,1.3) -- (2.2,1.5) -- cycle;
    \fill[white] (2.75,2.1) circle (0.08);
    \draw (2.75,2.1) circle (0.08);
    \draw[red, line width=1.75pt] (0.9,2.1) -- (2.8,2.1);
    \draw[fill=gray!40] (5.1,0) rectangle (5.2,1.3);
    \draw[fill=gray!15] (4.7,3.1) -- (5.8,2.9) -- (5.8,1.1) -- (4.7,1.3) -- cycle;
    \fill[red!15,opacity=0.6] (3.3,2.2) -- (5.25,2.55) -- (5.25,1.65) -- (3.3,2) -- cycle;
    \draw[red!60,dashed] (3.3,2.2) -- (5.25,2.55);
    \draw[red!60,dashed] (3.3,2) -- (5.25,1.65);
    \fill[red!15,opacity=0.6] (5.25,1.65) arc (-90:90:0.45);
    \begin{scope}[rotate around={-11:(5.25,2.1)}]
        \draw[red!85!black,line width=1pt] (5.25,2.1) circle (0.09);
        \draw[red!85!black,line width=1pt] (5.25,2.1) circle (0.20);
        \draw[red!85!black,line width=1pt] (5.25,2.1) circle (0.32);
        \draw[red!85!black,line width=1pt] (5.25,2.1) circle (0.44);
        \fill[red!90!black] (5.25,2.1) circle (0.05);
    \end{scope}
