<Window x:Class="TikzEdt.Modern.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:local="clr-namespace:TikzEdt.Modern"
        Title="TikzEdt Modern" Width="1440" Height="900" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="SnippetAccordion" TargetType="Expander">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
                <StackPanel>
                    <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" HorizontalContentAlignment="Stretch" Margin="0,2" Padding="7">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="CategoryChrome" Background="{StaticResource RaisedBrush}" Padding="{TemplateBinding Padding}" CornerRadius="3"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CategoryChrome" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Path x:Name="CategoryArrow" Data="M 2 1 L 7 6 L 2 11" Stroke="{StaticResource TextBrush}" StrokeThickness="1.3" Width="10" Height="12" RenderTransformOrigin="0.5,0.5"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding ItemCount}" Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0"/>
                        </Grid>
                    </ToggleButton>
                    <ContentPresenter x:Name="CategoryContent" ContentSource="Content" Visibility="Collapsed"/>
                </StackPanel>
                <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="CategoryContent" Property="Visibility" Value="Visible"/><Setter TargetName="CategoryArrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="_File" Foreground="White"><MenuItem Header="New" InputGestureText="Ctrl+N" Click="New_Click"/><MenuItem Header="Open…" InputGestureText="Ctrl+O" Click="Open_Click"/><Separator/><MenuItem Header="Save" InputGestureText="Ctrl+S" Click="Save_Click"/><MenuItem Header="Save As…" Click="SaveAs_Click"/></MenuItem>
            <MenuItem Header="_Edit" Foreground="White"><MenuItem Header="Undo" InputGestureText="Ctrl+Z" Click="Undo_Click"/><MenuItem Header="Redo" InputGestureText="Ctrl+Y" Click="Redo_Click"/><Separator/><MenuItem Header="Find…" InputGestureText="Ctrl+F" Command="ApplicationCommands.Find" CommandTarget="{Binding ElementName=Editor}"/></MenuItem>
            <MenuItem Header="_View" Foreground="White"><MenuItem Header="Files sidebar" Click="FilesSidebar_Click"/><MenuItem Header="Snippets sidebar" Click="Snippets_Click"/><Separator/><MenuItem Header="Fold all" InputGestureText="Ctrl+Shift+[" Click="FoldAll_Click"/><MenuItem Header="Unfold all" InputGestureText="Ctrl+Shift+]" Click="UnfoldAll_Click"/></MenuItem>
            <MenuItem Header="_Build" Foreground="White">
                <MenuItem Header="Compile" InputGestureText="F5" Click="Compile_Click"/><MenuItem Header="Cancel" Click="CancelCompile_Click"/>
                <Separator/>
                <MenuItem x:Name="BuildSnippetPreviewsMenu" Header="Compile all snippet previews" Click="BuildSnippetPreviews_Click" ToolTip="Build all previews with the selected compiler and current preamble. Cached previews are reused; failed previews are retried."/>
                <MenuItem x:Name="PauseSnippetBuildMenu" Header="Pause snippet preview build" Click="PauseSnippetPreviews_Click" IsEnabled="False"/>
                <MenuItem x:Name="ResumeSnippetBuildMenu" Header="Resume saved snippet preview build" Click="ResumeSnippetPreviews_Click" IsEnabled="False"/>
                <MenuItem Header="Open snippet preview cache folder" Click="OpenSnippetCache_Click"/>
                <MenuItem x:Name="SnippetBuildStatusMenu" Header="Snippet preview build not started" IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="_Tools" Foreground="White"><MenuItem Header="Preamble…" Click="Preamble_Click"/><MenuItem Header="Settings…" Click="Settings_Click"/><MenuItem Header="Snippets…" Click="Snippets_Click"/></MenuItem>
            <MenuItem Header="_Help" Foreground="White"><MenuItem Header="TikZ/PGF Manual"/><MenuItem Header="About"/></MenuItem>
        </Menu>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel Margin="8,5">
                <Border x:Name="SnippetBuildPanel" Visibility="Collapsed" Background="{StaticResource RaisedBrush}" CornerRadius="3" Padding="8,4" Margin="0,0,0,4">
                    <DockPanel>
                        <ProgressBar x:Name="SnippetBuildProgress" Width="120" Height="5" DockPanel.Dock="Left" Margin="0,0,10,0" Maximum="1" Background="{StaticResource WindowBrush}" Foreground="{StaticResource AccentBrush}" BorderThickness="0"/>
                        <TextBlock x:Name="SnippetBuildText" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>
                <WrapPanel VerticalAlignment="Center">
                    <Button x:Name="SidebarToggleButton" Click="ToggleSidebar_Click" ToolTip="Show / hide sidebar (Ctrl+B)"><local:IconLabel Icon="files"/></Button>
                    <Button Click="New_Click" ToolTip="New (Ctrl+N)"><local:IconLabel Icon="new" Text="New"/></Button>
                    <Button Click="Open_Click" ToolTip="Open (Ctrl+O)"><local:IconLabel Icon="open" Text="Open"/></Button>
                    <Button Click="Save_Click" ToolTip="Save (Ctrl+S)"><local:IconLabel Icon="save" Text="Save"/></Button>
                    <Button Click="Undo_Click" ToolTip="Undo (Ctrl+Z)"><local:IconLabel Icon="undo"/></Button>
                    <Button Click="Redo_Click" ToolTip="Redo (Ctrl+Y)"><local:IconLabel Icon="redo"/></Button>
                    <Button Click="FoldAll_Click" ToolTip="Fold all (Ctrl+Shift+[)"><local:IconLabel Icon="fold"/></Button>
                    <Button Click="UnfoldAll_Click" ToolTip="Unfold all (Ctrl+Shift+])"><local:IconLabel Icon="unfold"/></Button>
                    <RadioButton x:Name="WysiwygMode" GroupName="EditorMode" Style="{StaticResource ModeButton}" Content="WYSIWYG" IsChecked="True" Checked="Mode_Checked" />
                    <RadioButton x:Name="PreviewMode" GroupName="EditorMode" Style="{StaticResource ModeButton}" Content="Preview" Checked="Mode_Checked" />
                    <RadioButton x:Name="ProductionMode" GroupName="EditorMode" Style="{StaticResource ModeButton}" Content="Production" Checked="Mode_Checked" />
                    <Button x:Name="PreambleButton" ToolTip="Select and edit the LaTeX preamble" Click="Preamble_Click" Padding="9,6"><local:IconLabel Icon="preamble" Text="Preamble"/></Button>
                    <Button Click="CopySvg_Click" ToolTip="Copy the compiled figure as vector SVG for pasting into other applications"><local:IconLabel Icon="copy" Text="SVG"/></Button>
                    <TextBlock Text="Engine" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,7,0" />
                    <ComboBox x:Name="EngineSelector" Width="125" SelectedIndex="0"><ComboBoxItem Tag="pdflatex">pdfLaTeX</ComboBoxItem><ComboBoxItem Tag="lualatex">LuaLaTeX</ComboBoxItem><ComboBoxItem Tag="xelatex">XeLaTeX</ComboBoxItem></ComboBox>
                    <Button Style="{StaticResource PrimaryButton}" Click="Compile_Click" ToolTip="Compile (F5)"><local:IconLabel Icon="compile" Text="Compile"/></Button>
                </WrapPanel>
                <WrapPanel x:Name="WysiwygTools" Margin="0,4,0,0">
                    <RadioButton x:Name="SelectTool" GroupName="DrawingTool" Style="{StaticResource ToolButton}" IsChecked="True" Checked="DrawingTool_Changed" ToolTip="Select objects, box-select, Ctrl+click to add/remove; drag to move"><local:IconLabel Icon="select" Text="Select"/></RadioButton>
                    <RadioButton x:Name="EditTool" GroupName="DrawingTool" Style="{StaticResource ToolButton}" Checked="DrawingTool_Changed" ToolTip="Edit coordinates by dragging the thin X markers; Delete removes selected objects"><local:IconLabel Icon="edit" Text="Edit"/></RadioButton>
                    <RadioButton x:Name="NodeTool" GroupName="DrawingTool" Style="{StaticResource ToolButton}" Checked="DrawingTool_Changed" ToolTip="Click to insert a node"><local:IconLabel Icon="node" Text="Node"/></RadioButton>
                    <RadioButton x:Name="PathTool" GroupName="DrawingTool" Style="{StaticResource ToolButton}" Checked="DrawingTool_Changed" ToolTip="Drag to draw a straight path"><local:IconLabel Icon="path" Text="Path"/></RadioButton>
                    <RadioButton x:Name="BezierTool" GroupName="DrawingTool" Style="{StaticResource ToolButton}" Checked="DrawingTool_Changed" ToolTip="Click start, first control, second control, then end"><local:IconLabel Icon="bezier" Text="Bézier"/></RadioButton>
                    <RadioButton x:Name="SmoothTool" GroupName="DrawingTool" Style="{StaticResource ToolButton}" Checked="DrawingTool_Changed" ToolTip="Click through curve points; Enter or double-click to finish"><local:IconLabel Icon="smooth" Text="Smooth"/></RadioButton>
                    <RadioButton x:Name="RectangleTool" GroupName="DrawingTool" Style="{StaticResource ToolButton}" Checked="DrawingTool_Changed" ToolTip="Drag to draw a rectangle"><local:IconLabel Icon="rectangle" Text="Rect"/></RadioButton>
                    <RadioButton x:Name="EllipseTool" GroupName="DrawingTool" Style="{StaticResource ToolButton}" Checked="DrawingTool_Changed" ToolTip="Drag a bounding box for an ellipse"><local:IconLabel Icon="ellipse" Text="Ellipse"/></RadioButton>
                    <RadioButton x:Name="GridTool" GroupName="DrawingTool" Style="{StaticResource ToolButton}" Checked="DrawingTool_Changed" ToolTip="Click two opposite grid corners; uses the grid spacing below"><local:IconLabel Icon="grid" Text="Grid"/></RadioButton>
                    <RadioButton x:Name="ArcTool" GroupName="DrawingTool" Style="{StaticResource ToolButton}" Checked="DrawingTool_Changed" ToolTip="Click center, start, end direction for a counterclockwise arc"><local:IconLabel Icon="arc" Text="Arc"/></RadioButton>
                    <RadioButton x:Name="PieTool" GroupName="DrawingTool" Style="{StaticResource ToolButton}" Checked="DrawingTool_Changed" ToolTip="Click center, start, end direction for a pie sector"><local:IconLabel Icon="pie" Text="Pie"/></RadioButton>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="250" MinWidth="200"/><ColumnDefinition x:Name="SidebarSplitterColumn" Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="SidebarRail" Grid.Column="0" Background="{StaticResource PanelBrush}" Visibility="Collapsed">
                <StackPanel Margin="1,5">
                    <RadioButton x:Name="FilesRailButton" GroupName="SidebarRail" Style="{StaticResource ToolButton}" Width="28" Height="68" Margin="0,2" Padding="3" Click="FilesSidebar_Click" ToolTip="Expand Files sidebar"><TextBlock Text="Files"><TextBlock.LayoutTransform><RotateTransform Angle="-90"/></TextBlock.LayoutTransform></TextBlock></RadioButton>
                    <RadioButton x:Name="SnippetsRailButton" GroupName="SidebarRail" Style="{StaticResource ToolButton}" Width="28" Height="88" Margin="0,2" Padding="3" Click="Snippets_Click" ToolTip="Expand Snippets sidebar"><TextBlock Text="Snippets"><TextBlock.LayoutTransform><RotateTransform Angle="-90"/></TextBlock.LayoutTransform></TextBlock></RadioButton>
                </StackPanel>
            </Border>
            <Border x:Name="SidebarHost" Grid.Column="0" Background="#25262A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                <TabControl x:Name="SidebarTabs" Margin="4">
                    <TabItem x:Name="FilesSidebarTab"><TabItem.Header><local:IconLabel Icon="files" Text="Files"/></TabItem.Header>
                        <DockPanel Margin="5">
                            <StackPanel DockPanel.Dock="Top"><WrapPanel><Button Content="Folder…" Click="BrowseFolder_Click"/><Button Content="↑" Click="ParentFolder_Click" ToolTip="Parent folder"/><Button Content="↻" Click="RefreshFiles_Click" ToolTip="Refresh files"/></WrapPanel><TextBlock x:Name="FolderPathText" TextTrimming="CharacterEllipsis" Margin="3,6"/></StackPanel>
                            <ListBox x:Name="SidebarFiles" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" BorderThickness="0" MouseDoubleClick="SidebarFile_Open" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="3,5"><local:ToolIcon Kind="{Binding Icon}"/><TextBlock Text="{Binding Name}" Margin="7,0" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem x:Name="SnippetsSidebarTab"><TabItem.Header><local:IconLabel Icon="snippets" Text="Snippets"/></TabItem.Header>
                        <Grid Margin="5"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBox x:Name="SidebarSnippetSearch" Padding="6" TextChanged="SidebarSnippetSearch_Changed" ToolTip="Search across snippet categories"/>
                                <TextBlock x:Name="SidebarSnippetCount" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,6"/>
                            </StackPanel>
                            <ListBox x:Name="SidebarSnippets" Grid.Row="1" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" SelectionChanged="SidebarSnippet_Selected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                                <ListBox.GroupStyle><GroupStyle><GroupStyle.ContainerStyle><Style TargetType="GroupItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem"><Expander x:Name="SnippetCategoryExpander" Style="{StaticResource SnippetAccordion}" Expanded="SnippetCategory_Expanded" Collapsed="SnippetCategory_Collapsed" Loaded="SnippetCategory_Loaded"><ItemsPresenter/></Expander></ControlTemplate></Setter.Value></Setter></Style></GroupStyle.ContainerStyle></GroupStyle></ListBox.GroupStyle>
                                <ListBox.ItemTemplate><DataTemplate><Grid Margin="3,5" ToolTip="{Binding Description}"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border x:Name="SnippetThumbnail" Width="76" Height="54" HorizontalAlignment="Left" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="2" Loaded="SidebarThumbnail_Loaded"><Image Source="{Binding Preview}" Stretch="Uniform" Margin="3" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
                                    <StackPanel x:Name="SnippetLabels" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding State}" FontSize="10" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel>
                                </Grid></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="2"><ProgressBar x:Name="SidebarSnippetProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock x:Name="SidebarSnippetState" Text="Select a snippet" TextWrapping="Wrap" FontSize="11" Margin="0,4"/></StackPanel>
                            <WrapPanel Grid.Row="3"><Button x:Name="SidebarInsertCodeButton" Content="Insert code" IsEnabled="False" Click="SidebarInsertCode_Click"/><Button x:Name="SidebarInsertExampleButton" Content="Example" IsEnabled="False" Click="SidebarInsertExample_Click"/><Button Content="Browse…" Click="BrowseSnippets_Click"/></WrapPanel>
                        </Grid>
                    </TabItem>
                </TabControl>
                </DockPanel>
            </Border>
            <Grid x:Name="SidebarSplitter" Grid.Column="1" Background="{StaticResource PanelBrush}">
                <Thumb x:Name="SidebarResizeThumb" Cursor="SizeWE" DragStarted="SidebarResize_Started" DragDelta="SidebarResize_Delta" DragCompleted="SidebarResize_Completed" ToolTip="Drag to resize; drag left past the threshold to collapse">
                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent"><Border Width="1" HorizontalAlignment="Center" Background="{StaticResource BorderBrush}"/></Border></ControlTemplate></Thumb.Template>
                </Thumb>
                <Button x:Name="SidebarChevronButton" Width="10" Height="44" VerticalAlignment="Center" Margin="0" Padding="0" BorderThickness="0" Background="{StaticResource PanelBrush}" Click="ToggleSidebar_Click" ToolTip="Collapse sidebar (Ctrl+B)" AutomationProperties.Name="Collapse or expand sidebar">
                    <Path x:Name="SidebarChevron" Data="M 6 2 L 2 7 L 6 12" Stroke="{StaticResource TextBrush}" StrokeThickness="1" Width="8" Height="14"/>
                </Button>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="190"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource WindowBrush}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"><Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="DocumentNameText" Text="Untitled.tikz" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="TikZ Source" Margin="10,0,0,0" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/></Grid></Border>
                            <avalon:TextEditor x:Name="Editor" Grid.Row="1" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" LineNumbersForeground="{StaticResource MutedBrush}" FontFamily="Cascadia Mono,Consolas" FontSize="14" ShowLineNumbers="True" Padding="10,8" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Border>
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />
                    <Border Grid.Column="2" Background="#25262A">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"><DockPanel Margin="8,0">
                                <TextBlock Text="Live Preview" VerticalAlignment="Center" Margin="8,0"/>
                            </DockPanel></Border>
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <ScrollViewer x:Name="GraphicalScroller" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                              Background="#25262A" Padding="6" PanningMode="Both" PanningRatio="1"
                                              PanningDeceleration="0.001" PreviewMouseWheel="GraphicalScroller_PreviewMouseWheel">
                                <ScrollViewer.Template>
                                    <ControlTemplate TargetType="ScrollViewer">
                                        <Grid Background="{TemplateBinding Background}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}"
                                                Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}"/>
                                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical"
                                                Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                                Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                                Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                                            <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal"
                                                Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                                                Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                                Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/>
                                            <Border x:Name="ScrollBarCorner" Grid.Row="1" Grid.Column="1" Background="{TemplateBinding Background}"/>
                                        </Grid>
                                    </ControlTemplate>
                                </ScrollViewer.Template>
                                <ScrollViewer.Resources>
                                    <Style x:Key="SlimScrollThumb" TargetType="Thumb">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="ThumbChrome" Background="#69707A" CornerRadius="4" Margin="1" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbChrome" Property="Background" Value="#8A919C"/></Trigger>
                                                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbChrome" Property="Background" Value="{StaticResource AccentBrush}"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
                                        <Setter Property="Focusable" Value="False"/>
                                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
                                    </Style>
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Width" Value="9"/>
                                        <Setter Property="Background" Value="#25262A"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ScrollBar">
                                                    <Grid Width="9" Background="{TemplateBinding Background}">
                                                        <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                                            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPageButton}" Command="{x:Static ScrollBar.PageUpCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"/></Track.DecreaseRepeatButton>
                                                            <Track.Thumb><Thumb Style="{StaticResource SlimScrollThumb}"/></Track.Thumb>
                                                            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPageButton}" Command="{x:Static ScrollBar.PageDownCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"/></Track.IncreaseRepeatButton>
                                                        </Track>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="Orientation" Value="Horizontal">
                                                <Setter Property="Width" Value="Auto"/>
                                                <Setter Property="Height" Value="9"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ScrollBar">
                                                            <Grid Height="9" Background="{TemplateBinding Background}">
                                                                <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False">
                                                                    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPageButton}" Command="{x:Static ScrollBar.PageLeftCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"/></Track.DecreaseRepeatButton>
                                                                    <Track.Thumb><Thumb Style="{StaticResource SlimScrollThumb}"/></Track.Thumb>
                                                                    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPageButton}" Command="{x:Static ScrollBar.PageRightCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"/></Track.IncreaseRepeatButton>
                                                                </Track>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Resources>
                                <Border x:Name="GraphicalSurface" Width="6000" Height="6000" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="2">
                                    <Border.LayoutTransform><ScaleTransform x:Name="GraphicalScale" ScaleX="1" ScaleY="1"/></Border.LayoutTransform>
                                    <Grid ClipToBounds="True">
                                        <Grid.Resources>
                                            <DrawingBrush x:Key="PreviewGridBrush" TileMode="Tile" Viewport="0,0,25,25" ViewportUnits="Absolute" Viewbox="0,0,25,25" ViewboxUnits="Absolute">
                                                <DrawingBrush.Drawing><GeometryDrawing Brush="White"><GeometryDrawing.Pen><Pen Brush="#E2E5E9" Thickness="0.5"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,25,25"/></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing>
                                            </DrawingBrush>
                                        </Grid.Resources>
                                        <Rectangle x:Name="PreviewGrid" Fill="{StaticResource PreviewGridBrush}" />
                                        <Canvas x:Name="CompiledPreviewLayer" IsHitTestVisible="False">
                                            <Image x:Name="CompiledPreviewImage" Stretch="Fill" SnapsToDevicePixels="True"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Canvas>
                                        <Canvas x:Name="OverlayCanvas" Background="Transparent" Cursor="Arrow" MouseLeftButtonDown="OverlayCanvas_MouseLeftButtonDown" MouseLeftButtonUp="OverlayCanvas_MouseLeftButtonUp" MouseMove="OverlayCanvas_MouseMove" MouseLeave="OverlayCanvas_MouseLeave" />
                                        <TextBlock x:Name="PreviewMessage" Text="Rendered PDF preview" Foreground="#707070" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
                <GridSplitter Grid.Row="1" Height="5" VerticalAlignment="Top" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}" />
                <Border Grid.Row="1" Margin="0,5,0,0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <TabControl x:Name="BottomTabs" Background="Transparent" BorderThickness="0">
                        <TabItem x:Name="ProblemsTab" Header="Problems  0">
                            <ListBox x:Name="ProblemsList" Margin="6" BorderThickness="0" Background="Transparent"
                                     MouseDoubleClick="ProblemsList_MouseDoubleClick"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="5,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SeverityGlyph}" Foreground="#FF5252" FontSize="10" VerticalAlignment="Top" Margin="3,3,0,0"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                                                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0">
                                                    <Run Text="{Binding Source, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Location, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="Double-click to navigate" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                        <TabItem x:Name="OutputTab" Header="Output"><TextBox x:Name="OutputText" Margin="8" BorderThickness="0" IsReadOnly="True" Text="TikzEdt Modern ready." AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="10,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Zoom" VerticalAlignment="Center"/>
                    <Slider x:Name="ZoomSlider" Width="90" Minimum="25" Maximum="1600" Value="100" TickFrequency="25" IsSnapToTickEnabled="True" Margin="6,0,4,0" ValueChanged="ZoomSlider_ValueChanged"/>
                    <TextBlock x:Name="ZoomText" Text="100%" Width="45" VerticalAlignment="Center"/>
                    <Button Content="Center" Padding="7,2" Margin="3,0,10,0" Click="CenterOrigin_Click"/>
                    <TextBlock x:Name="MousePositionText" Text="Mouse —" Width="180" FontFamily="Consolas" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <CheckBox x:Name="GridToggle" Content="Grid" IsChecked="True" Foreground="White" VerticalAlignment="Center" Checked="GridToggle_Changed" Unchecked="GridToggle_Changed"/>
                    <CheckBox x:Name="SnapToggle" Content="Snap" IsChecked="True" Foreground="White" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBlock Text="Step" VerticalAlignment="Center" Margin="6,0,4,0"/>
                    <ComboBox x:Name="GridStepSelector" Width="58" Height="23" Padding="4,1" SelectedIndex="2" SelectionChanged="GridStepSelector_SelectionChanged">
                        <ComboBoxItem Tag="0.1">0.1</ComboBoxItem><ComboBoxItem Tag="0.2">0.2</ComboBoxItem><ComboBoxItem Tag="0.5">0.5</ComboBoxItem><ComboBoxItem Tag="1">1</ComboBoxItem>
                    </ComboBox>
                    <TextBlock x:Name="GridKindText" Text="Cartesian" Width="62" VerticalAlignment="Center" Margin="7,0,12,0"/>
                    <ComboBox x:Name="CoordinateSystemSelector" Width="100" Height="24" Padding="5,1" SelectedIndex="0" SelectionChanged="CoordinateSystem_Changed" ToolTip="Coordinate system for the grid and snapping">
                        <ComboBoxItem Tag="Auto">Auto</ComboBoxItem><ComboBoxItem Tag="Cartesian">Cartesian</ComboBoxItem><ComboBoxItem Tag="Polar">Polar</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
                <TextBlock x:Name="ModeStatus" Text="WYSIWYG mode · graphical editing enabled" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
